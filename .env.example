# 실제 비밀값은 .env 또는 실행 환경에만 설정한다.
# python scripts/init_lab_env.py로 로컬 실습 계정이 담긴 .env 생성.
# Compose는 .env를 읽는다. 값이 비어 있으면 실행을 거부한다.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_DEFAULT_REGION=ap-northeast-2
# AWS Access Key/Secret Key를 이 파일에 추가하지 않는다.
# AWS S3는 이후 단계에서 SDK 기본 인증 체인을 사용한다.
